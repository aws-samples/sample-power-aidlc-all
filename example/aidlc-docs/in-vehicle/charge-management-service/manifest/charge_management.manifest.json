{
  "$comment": "Simplified AUTOSAR Adaptive application manifest (Step 6: deployment artifacts + manifest). On target this would be ARXML; modeled as JSON here for readability.",
  "application": {
    "name": "charge-management-service",
    "version": "1.3.0",
    "unit": "U3",
    "tracesTo": ["CS-FR-014", "CS-FR-021", "CS-FR-030", "CS-FR-031"]
  },
  "execution": {
    "executable": "charge_management_service",
    "schedulingPolicy": "SCHED_FIFO",
    "startupConfig": "default"
  },
  "services": {
    "offered": [
      {
        "name": "ChargeManagement",
        "binding": "SOME/IP",
        "methods": ["SetSchedule", "GetStatus"],
        "events": ["ChargeStatus"]
      }
    ],
    "required": [
      {
        "name": "BmsInterface",
        "providedBy": "bms-interface-adapter (U4)",
        "binding": "ara::com",
        "safetyRelevant": true,
        "note": "Only the U4 adapter talks to the BMS; QM service must not interfere (freedom from interference)."
      }
    ]
  },
  "security": {
    "commandIntegrity": "mTLS + signed payload (CS-SEC-005)",
    "scope": "UNECE R155"
  }
}
